_:
    @just --list --list-submodules

install:
    npm install

upgrade:
    npm update

gen:
    uv run proxy openapi ../openapi.json
    npm exec -- orval
    node scripts/strip-unused-generated-exports.mjs

lint:
    npm exec -- biome check --write
    just --unstable --fmt

dev:
    npm run dev
