{
  "$defs": {
    "AdminConfig": {
      "additionalProperties": false,
      "description": "Runtime administration identity provider.",
      "properties": {
        "auth": {
          "discriminator": {
            "mapping": {
              "jwt": "#/$defs/JwtAuthProviderConfig",
              "keycloak": "#/$defs/KeycloakAuthProviderConfig",
              "static": "#/$defs/StaticCredentialsAuthProviderConfig"
            },
            "propertyName": "provider"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/JwtAuthProviderConfig"
            },
            {
              "$ref": "#/$defs/KeycloakAuthProviderConfig"
            },
            {
              "$ref": "#/$defs/StaticCredentialsAuthProviderConfig"
            }
          ],
          "title": "Auth"
        },
        "session_cookie_samesite": {
          "default": "lax",
          "description": "SameSite policy for the admin session cookie. 'lax' suits the default same-site deployment where the admin UI and the gateway share a site; 'none' is required when the UI is served from a different site and requires HTTPS. With 'none', state-changing admin requests are additionally checked against the configured CORS origins.",
          "enum": [
            "strict",
            "lax",
            "none"
          ],
          "title": "Session Cookie Samesite",
          "type": "string"
        }
      },
      "required": [
        "auth"
      ],
      "title": "AdminConfig",
      "type": "object"
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "description": "PostgreSQL persistence for server configuration and usage tracing.",
      "properties": {
        "url": {
          "description": "Async PostgreSQL DSN (for example postgresql+asyncpg://...).",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "DatabaseConfig",
      "type": "object"
    },
    "HostConfig": {
      "additionalProperties": false,
      "description": "HTTP listener settings.",
      "properties": {
        "address": {
          "default": "127.0.0.1",
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 8008,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "HostConfig",
      "type": "object"
    },
    "JwtAuthProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "jwt",
          "title": "Provider",
          "type": "string"
        },
        "public_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Key"
        },
        "jwks_uri": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jwks Uri"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "algorithm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm"
        },
        "required_scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Scopes"
        },
        "ssrf_safe": {
          "default": false,
          "title": "Ssrf Safe",
          "type": "boolean"
        }
      },
      "required": [
        "provider"
      ],
      "title": "JwtAuthProviderConfig",
      "type": "object"
    },
    "KeycloakAuthProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "keycloak",
          "title": "Provider",
          "type": "string"
        },
        "realm_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Realm Url",
          "type": "string"
        },
        "required_scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Scopes"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        }
      },
      "required": [
        "provider",
        "realm_url"
      ],
      "title": "KeycloakAuthProviderConfig",
      "type": "object"
    },
    "LogfireConfig": {
      "additionalProperties": false,
      "description": "Logfire observability settings.",
      "properties": {
        "token": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token"
        },
        "environment": {
          "default": "dev",
          "title": "Environment",
          "type": "string"
        },
        "service_name": {
          "default": "proxy",
          "title": "Service Name",
          "type": "string"
        }
      },
      "title": "LogfireConfig",
      "type": "object"
    },
    "StaticCredentialsAuthProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "static",
          "title": "Provider",
          "type": "string"
        },
        "username": {
          "default": "user",
          "title": "Username",
          "type": "string"
        },
        "password": {
          "format": "password",
          "title": "Password",
          "type": "string",
          "writeOnly": true
        },
        "jwt_secret": {
          "format": "password",
          "title": "Jwt Secret",
          "type": "string",
          "writeOnly": true
        },
        "token_ttl_seconds": {
          "default": 3600,
          "exclusiveMinimum": 0,
          "title": "Token Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "provider"
      ],
      "title": "StaticCredentialsAuthProviderConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validated, environment-independent gateway configuration.",
  "properties": {
    "host": {
      "$ref": "#/$defs/HostConfig"
    },
    "logfire": {
      "$ref": "#/$defs/LogfireConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig"
    },
    "public_base_url": {
      "default": "http://127.0.0.1:8008/",
      "format": "uri",
      "minLength": 1,
      "title": "Public Base Url",
      "type": "string"
    },
    "cors_origins": {
      "items": {
        "format": "uri",
        "minLength": 1,
        "type": "string"
      },
      "title": "Cors Origins",
      "type": "array"
    },
    "admin": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdminConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "database"
  ],
  "title": "GatewayConfig",
  "type": "object"
}
