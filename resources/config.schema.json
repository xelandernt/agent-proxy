{"$defs": {"ConfigCors": {"description": "Cors configuration.", "properties": {"origins": {"items": {"type": "string"}, "title": "Origins", "type": "array"}, "allow_credentials": {"default": true, "description": "If this is true, then `*` in origins will be ignored as per CORS spec.", "title": "Allow Credentials", "type": "boolean"}, "allow_methods": {"items": {"type": "string"}, "title": "Allow Methods", "type": "array"}, "allow_headers": {"items": {"type": "string"}, "title": "Allow Headers", "type": "array"}}, "title": "ConfigCors", "type": "object"}, "ConfigDisabledAuthProvider": {"description": "Anonymous passthrough for a group of MCP servers.", "properties": {"provider": {"const": "disabled", "default": "disabled", "title": "Provider", "type": "string"}}, "title": "ConfigDisabledAuthProvider", "type": "object"}, "ConfigEntraIdAuthProvider": {"description": "Azure Entra ID bearer-token validation settings.", "properties": {"provider": {"const": "entra_id", "default": "entra_id", "title": "Provider", "type": "string"}, "authority": {"default": "https://login.microsoftonline.com", "title": "Authority", "type": "string"}, "tenant_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Tenant Id"}, "issuer": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Issuer"}, "allowed_algorithms": {"items": {"type": "string"}, "title": "Allowed Algorithms", "type": "array"}, "clock_skew_seconds": {"default": 30, "minimum": 0, "title": "Clock Skew Seconds", "type": "integer"}, "discovery_ttl_seconds": {"default": 3600, "minimum": 60, "title": "Discovery Ttl Seconds", "type": "integer"}}, "title": "ConfigEntraIdAuthProvider", "type": "object"}, "ConfigHost": {"description": "Configuration for a host.", "properties": {"address": {"default": "127.0.0.1", "title": "Address", "type": "string"}, "port": {"default": 8008, "title": "Port", "type": "integer"}}, "title": "ConfigHost", "type": "object"}, "ConfigLogfire": {"description": "Configuration for observability.", "properties": {"token": {"anyOf": [{"format": "password", "type": "string", "writeOnly": true}, {"type": "null"}], "default": null, "title": "Token"}, "environment": {"default": "dev", "title": "Environment", "type": "string"}, "service_name": {"default": "proxy", "title": "Service Name", "type": "string"}}, "title": "ConfigLogfire", "type": "object"}, "ConfigMcp": {"description": "Grouped MCP backend registry.", "properties": {"groups": {"items": {"$ref": "#/$defs/ConfigMcpGroup"}, "title": "Groups", "type": "array"}}, "title": "ConfigMcp", "type": "object"}, "ConfigMcpGroup": {"description": "A group of MCP servers sharing one auth provider.", "properties": {"name": {"pattern": "^[a-z0-9][a-z0-9-]*$", "title": "Name", "type": "string"}, "auth": {"discriminator": {"mapping": {"disabled": "#/$defs/ConfigDisabledAuthProvider", "entra_id": "#/$defs/ConfigEntraIdAuthProvider"}, "propertyName": "provider"}, "oneOf": [{"$ref": "#/$defs/ConfigDisabledAuthProvider"}, {"$ref": "#/$defs/ConfigEntraIdAuthProvider"}], "title": "Auth"}, "default_required_scopes": {"items": {"type": "string"}, "title": "Default Required Scopes", "type": "array"}, "servers": {"items": {"$ref": "#/$defs/ConfigMcpServer"}, "minItems": 1, "title": "Servers", "type": "array"}}, "required": ["name", "servers"], "title": "ConfigMcpGroup", "type": "object"}, "ConfigMcpServer": {"description": "Configuration for an upstream MCP HTTP endpoint.", "properties": {"name": {"pattern": "^[a-z0-9][a-z0-9-]*$", "title": "Name", "type": "string"}, "endpoint": {"format": "uri", "minLength": 1, "title": "Endpoint", "type": "string"}, "resource": {"anyOf": [{"format": "uri", "minLength": 1, "type": "string"}, {"type": "null"}], "default": null, "title": "Resource"}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Description"}, "required_scopes": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "title": "Required Scopes"}}, "required": ["name", "endpoint"], "title": "ConfigMcpServer", "type": "object"}, "ConfigMiddleware": {"description": "Middleware configuration.", "properties": {"cors": {"$ref": "#/$defs/ConfigCors"}}, "title": "ConfigMiddleware", "type": "object"}}, "additionalProperties": false, "properties": {"host": {"$ref": "#/$defs/ConfigHost"}, "logfire": {"$ref": "#/$defs/ConfigLogfire"}, "middleware": {"$ref": "#/$defs/ConfigMiddleware"}, "mcp": {"$ref": "#/$defs/ConfigMcp"}}, "title": "Config", "type": "object"}
